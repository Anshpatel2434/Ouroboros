# Copy to .env and fill in. One provider is enough.

# Groq (default provider)
GROQ_API_KEY=

# Anthropic (used when no Groq key is present)
# ANTHROPIC_API_KEY=

# Optional overrides
# OUROBOROS_LLM_PROVIDER=groq        # or anthropic
# OUROBOROS_DEFAULT_MODEL=openai/gpt-oss-120b
# OUROBOROS_CRITIC_MODEL=openai/gpt-oss-120b
